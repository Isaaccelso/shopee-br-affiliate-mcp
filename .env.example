# Example only. The server does not automatically load this file.
# For local stdio, or remote API-key mode, inject these through a secret manager.
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_ACCOUNT_REFERENCE=minha-conta
# Set absolute paths appropriate to the deployment:
SHOPEE_VERIFIED_PROFILE=/opt/shopee-affiliate-mcp/examples/profile.official.json
SHOPEE_HISTORY_DB=/opt/shopee-affiliate-mcp/data/history.sqlite3

# In production, put the generated MCP key in runtime secrets; never commit it.
# API key mode uses a fixed Shopee account configured in runtime secrets.
MCP_API_KEY=
# Only OAuth mode needs the following three settings:
# MCP_CREDENTIALS_KEY=
# MCP_STATE_DB=/app/data/oauth.sqlite3
MCP_PUBLIC_URL=https://mcp.example.com
# Por padrão, só ChatGPT (callbacks oficiais) e URLs exatas explicitamente cadastradas.
MCP_ALLOW_LOOPBACK_CALLBACKS=false
# Opcional: callbacks exatos adicionais para Hermes.
MCP_OAUTH_REDIRECT_URIS=[]

# Only OAuth mode needs this SHA256 owner-key hash.
# Guide: docs/DOKPLOY-PRIVADO.md
# MCP_OWNER_KEY_SHA256=
